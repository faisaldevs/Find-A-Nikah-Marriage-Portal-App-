# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# QA/audit tooling — screenshots, data dumps, QA emails; never commit
/audit/

# ── Secrets: never commit ─────────────────────────────────────────────
# Android signing keys and their passwords (also in android/.gitignore)
key.properties
**/key.properties
*.jks
*.keystore
*.p12
*.pfx
# Apple signing / push keys and profiles
*.p8
*.pem
*.cer
*.certSigningRequest
*.mobileprovision
# Firebase / Google Cloud service-account keys (server credentials)
*service-account*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json
*credentials*.json
.firebase/
firebase-debug.log
firebase-debug.*.log
# Environment files and local overrides
.env
.env.*
!.env.example
lib/flavors/env/*.local.json
secrets/
*.secret

# Android build output outside the root /build
/android/build/
/android/.gradle/
